# TypeSafe AI Jev API Key (Get from typesafe.ai)
TYPESAFE_API_KEY=your_typesafe_api_key_here
DECISION_MODEL=jev-latest

# Voice Language (ar-EG = Egyptian Arabic / ar-SA = Modern Standard Arabic / en-US = English)
VOICE_LANGUAGE=ar-EG

# Text to Speech Settings
TTS_VOICE=ar-EG-SalmaNeural
TTS_ENABLED=true

# Safety Settings
FAILSAFE_ENABLED=true
MAX_STEPS_PER_COMMAND=10
